# --- Chat model (works in demo mode too) ---
# CHAT_PROVIDER: ollama = free model on this computer (needs the Ollama app, no key, no cost)
#                claude = Claude (needs a key below)
#                auto   = Claude if a key is set, otherwise Ollama if it's running
CHAT_PROVIDER=auto
# Which Ollama model to use (see `ollama list`). Defaults to the first one installed.
OLLAMA_MODEL=
# For Claude, add ONE of these. Without any model, the chat gives clearly-labelled sample replies.
# Option A: an Anthropic API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Option B: Claude on Amazon Bedrock. A Bedrock API key, or normal AWS credentials (aws configure / SSO).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Optional model overrides (defaults: claude-opus-5-5 / anthropic.claude-opus-5-5)
# ANTHROPIC_MODEL=
# BEDROCK_MODEL_ID=

# --- File sorting ---
# true = rule-based sorting (no AI calls). false = Claude sorts the files (needs a key above).
MOCK_AI=true
PORT=8787
